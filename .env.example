MARIA_HOST=localhost
MARIA_PORT=3306
MARIA_USER=
MARIA_PASSWORD=
MARIA_DB=
MARIA_POOL_MIN=2
MARIA_POOL_MAX=10

MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_API_KEY=

# MCP 서버 URL (mcp_servers.yaml 에서 ${MARIA_MCP_URL} 로 참조)
MARIA_MCP_URL=http://localhost:8001/mcp/

# LLM 설정 (로컬: Ollama, 운영: vLLM — 동일 OpenAI 호환 API)
# 로컬 예: LLM_BASE_URL=http://localhost:11434/v1, LLM_MODEL=gemma4, LLM_API_KEY=ollama
# 운영 예: LLM_BASE_URL=http://<vllm-host>:8000/v1, LLM_MODEL=google/gemma-4-e4b-it
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=google/gemma-4-e4b-it
LLM_API_KEY=ollama

LOG_LEVEL=INFO
