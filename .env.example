MARIA_HOST=localhost
MARIA_PORT=3306
MARIA_USER=
MARIA_PASSWORD=
MARIA_DB=
MARIA_POOL_MIN=2
MARIA_POOL_MAX=5

MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_API_KEY=

# MCP 서버 URL (mcp_servers.yaml 에서 ${MARIA_MCP_URL} 로 참조)
MARIA_MCP_URL=http://localhost:8001/mcp/

# LLM 설정 (OpenAI 호환 API — Ollama / vLLM 동일 형식)
#
# [GPU 서버 vLLM — 직접 접속] ★ 기본 권장
#   8000 포트가 공인 IP 로 개방돼 있으면 SSH 터널 불필요.
# LLM_BASE_URL=http://<gpu-host>:8000/v1
# LLM_MODEL=/models/gemma-4-e4b-it
# LLM_API_KEY=EMPTY
#
# [GPU 서버 vLLM — SSH 포트 포워딩] (직접 접속 차단 시 폴백)
#   사전 준비: ssh -L 8000:localhost:8000 <user>@<gpu-host> -N
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=/models/gemma-4-e4b-it
# LLM_API_KEY=EMPTY
#
# [맥북 로컬 — Ollama] (오프라인 / 개발용)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4
# LLM_API_KEY=ollama
LLM_BASE_URL=http://<gpu-host>:8000/v1
LLM_MODEL=/models/gemma-4-e4b-it
LLM_API_KEY=EMPTY

LOG_LEVEL=INFO
